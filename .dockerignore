# ── Exclude everything by default, then allow only what the image needs ────────

# Large model artifacts — sarimax_model.pkl alone is 34 GB.
# data/ and models/ are mounted as volumes at runtime; they are not COPY'd.
models/
data/

# Notebooks, figures, and documentation — not needed inside the container.
*.ipynb
figures/
docs/
word_doc/
static_app/
scripts/

# Git history and dev tooling.
.git/
.gitignore
.vscode/
__pycache__/
*.py[cod]
*.egg-info/

# Tests — not executed at runtime.
tests/

# README and other root-level docs.
README.md
